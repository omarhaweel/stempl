# Supabase project (Settings > API). The secret key must NEVER be put in the app.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=
# Min 32 characters, e.g. generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Optional: comma-separated browser origins allowed by CORS (mobile app needs none)
ALLOWED_ORIGINS=
